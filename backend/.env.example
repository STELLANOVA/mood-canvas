# Liquid AI: any OpenAI-compatible endpoint serving an LFM model
# Local llama.cpp server (default), or a hosted endpoint such as OpenRouter (https://openrouter.ai/api/v1, model liquid/lfm-2.5-2.6b:free)
LIQUID_BASE_URL=http://localhost:8080/v1
LIQUID_API_KEY=not-needed
LIQUID_MODEL=LFM2-2.6B

# Agent planner (optional): sees only aggregates, never journal text, so a larger model is fine.
# Leave unset to reuse the Liquid endpoint. If the planner is unreachable the agent uses rule-based planning.
# PLANNER_BASE_URL=
# PLANNER_API_KEY=
# PLANNER_MODEL=

# Black Forest Labs (https://api.bfl.ai)
BFL_API_KEY=
BFL_MODEL=flux-2-pro

# Nimble (https://online.nimbleway.com/account-settings/api-keys)
NIMBLE_API_KEY=

# Tinybird: use your workspace's API host (shown in the Tinybird UI / `tb info`)
TB_HOST=https://api.tinybird.co
TB_TOKEN=

DEMO_USER_ID=demo
